# LinkedIn MCP (profile search/scrape)
LINKEDIN_USER_1=your-email@example.com
LINKEDIN_PASSWORD_1=your-password
COOKIE_DIR=./cookies

MCP_HOST=127.0.0.1
MCP_PORT=8050
MCP_TRANSPORT=stdio
MCP_TIMEOUT=150

# Apply MCP (Greenhouse discover + approve-gated apply)
JOBIFY_ROOT=.
CANDIDATE_DIR=./candidate
CANDIDATE_PROFILE=./candidate/profile.json
CANDIDATE_COMPANIES=./candidate/companies.json
APPLY_DATA_DIR=./candidate/data
APPLY_SUBMISSION_MODE=manual

# Optional: employer Greenhouse *Job Board API key* for mode=api submits.
# This is NOT your Greenhouse login password. Most candidates leave this empty
# and use submit_application(mode="manual").
# GREENHOUSE_JOB_BOARD_API_KEY=
