# LinkedIn credentials (required — use an account you own)
LINKEDIN_USER_1=your-email@example.com
LINKEDIN_PASSWORD_1=your-password

# Optional: additional accounts for rotation
# LINKEDIN_USER_2=another-email@example.com
# LINKEDIN_PASSWORD_2=another-password

# Where Selenium session cookies are stored (created automatically)
COOKIE_DIR=./cookies

# MCP server settings
MCP_HOST=127.0.0.1
MCP_PORT=8050
# Cursor works best with stdio. Use streamable-http for Gemini CLI / HTTP clients.
MCP_TRANSPORT=stdio
MCP_TIMEOUT=150
